#!/usr/bin/env bash
set -euo pipefail

TARGET="ef-code.loom"
VERSION="0.3.0"

usage() {
  cat <<'EOF'
Usage: omarchy-loom <command> [arguments]

Commands:
  add [--no-show] <path>...  Add local paths or URLs to the inbox
  text <text>                Add a plain-text snippet
  url <url>                  Add an HTTP(S) URL
  list                      List cards as JSON
  count                     Print the card count
  clear-inbox               Remove cards that are still in the inbox
  copy-prompt               Copy the deterministic selected-or-all prompt
  export                    Export a bounded local context bundle
  show | hide | toggle      Open or close the Loom popup
  version | help            Print version or this help
EOF
}

ipc() {
  local method="$1"
  shift
  if (($#)); then
    omarchy-shell "$TARGET" "$method" "$1"
  else
    omarchy-shell "$TARGET" "$method"
  fi
}

command_name="${1:-help}"
if (($#)); then shift; fi

case "$command_name" in
  add)
    quiet=false
    if [[ "${1:-}" == "--no-show" ]]; then quiet=true; shift; fi
    (($# > 0)) || { echo "omarchy-loom add needs at least one path or URL" >&2; exit 2; }
    payload="$(jq -cn --args '$ARGS.positional | {paths: .}' -- "$@")"
    if [[ "$quiet" == true ]]; then ipc addQuiet "$payload"; else ipc add "$payload"; fi
    ;;
  text)
    (($# > 0)) || { echo "omarchy-loom text needs text" >&2; exit 2; }
    text_value="$*"
    ipc stageText "$text_value"
    ;;
  url)
    (($# == 1)) || { echo "omarchy-loom url needs exactly one URL" >&2; exit 2; }
    ipc stageUrl "$1"
    ;;
  list) ipc list ;;
  count) ipc count ;;
  clear-inbox) ipc clearInbox ;;
  copy-prompt) ipc copyPrompt ;;
  export) ipc exportContext ;;
  show) ipc show ;;
  hide) ipc hide ;;
  toggle) ipc toggle ;;
  version) printf '%s\n' "$VERSION" ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $command_name" >&2; usage >&2; exit 2 ;;
esac
